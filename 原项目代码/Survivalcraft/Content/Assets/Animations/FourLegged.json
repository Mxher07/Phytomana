        "type": "FourLeggedFeed",
        "properties": {
          "HeadDownAngle": 0.5
        }
      }
    },
    "Death": {
      "driver": {
        "type": "FourLeggedDeath",
        "properties": {
          "DeathRollAngle": 90.0
        }
      }
    }
