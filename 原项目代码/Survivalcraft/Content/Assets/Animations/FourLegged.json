            "source": "driver:FourLeggedWalk",
            "driverArgs": { "Gait": 2 }
          }
        },
        {
          "condition": "[CanTrot] && [Speed] > 0.5 * [WalkSpeed]",
          "animation": {
            "source": "driver:FourLeggedWalk",
            "driverArgs": { "Gait": 1 }
          }
        },
        {
          "condition": "true",
          "animation": {
            "source": "driver:FourLeggedWalk",
            "driverArgs": { "Gait": 0 }
          }
        }
      ]
    },
    "activity": {
      "layer": "Head",
      "rules": [
        {
          "condition": "[FeedFactor] > 0",
          "animation": {
            "source": "driver:FourLeggedFeed"
          }
        },
        {
          "condition": "[ButtFactor] > 0",
          "animation": {
            "source": "driver:FourLeggedAttack"
          }
        },
        {
          "condition": "true",
          "animation": null
        }
      ]
    },
    "death": {
      "layer": "Death",
      "rules": [
        {
          "condition": "[DeathPhase] > 0",
          "animation": {
            "source": "driver:FourLeggedDeath"
          }
        },
        {
          "condition": "true",
          "animation": null
        }
      ]
    }
  },

  "parameters": {
