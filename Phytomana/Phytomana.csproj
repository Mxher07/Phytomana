<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <OutputType>Library</OutputType>
        <RootNamespace>Game</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Phytomana</AssemblyName>
        <Deterministic>true</Deterministic>
        <LangVersion>preview</LangVersion>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <Nullable>disable</Nullable>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <ErrorReport>prompt</ErrorReport>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DebugType>pdbonly</DebugType>
        <OutputPath>bin\Debug\</OutputPath>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DebugType>none</DebugType>
        <OutputPath>bin\Release\</OutputPath>
    </PropertyGroup>
    <ItemGroup>
    <Reference Include="Engine">
        <HintPath>$(MSBuildProjectDirectory)\.inbundled\Engine.dll</HintPath>
        <Private>false</Private>
    </Reference>
    <Reference Include="EntitySystem">
        <HintPath>$(MSBuildProjectDirectory)\.inbundled\EntitySystem.dll</HintPath>
        <Private>false</Private>
    </Reference>
    <Reference Include="Survivalcraft">
        <HintPath>$(MSBuildProjectDirectory)\.inbundled\Survivalcraft.dll</HintPath>
        <Private>false</Private>
    </Reference>
    <Reference Include="Survivalcraft.Multiplayer">
        <HintPath>$(MSBuildProjectDirectory)\.inbundled\Survivalcraft.Multiplayer.dll</HintPath>
        <Private>false</Private>
    </Reference>
</ItemGroup>
    <ItemGroup>
        <None Update="modinfo.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Assets\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Blocks/*.cs"/>
        <Compile Include="Blocks/Tools/*.cs"/>
        <Compile Include="Core/ManaSystem/*.cs"/>
        <Compile Include="Core/Flowers/*.cs"/>
        <Compile Include="Core/Events/*.cs"/>
        <Compile Include="Core/Registry/*.cs"/>
        <Compile Include="Network/*.cs"/>
        <Compile Include="Subsystems/*.cs"/>
        <Compile Include="Systems/*.cs"/>
        <Compile Include="PhytomanaMod.cs"/>
    </ItemGroup>
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <PropertyGroup>
            <PathOfScmod>$(TargetDir)..\$(AssemblyName).netmod</PathOfScmod>
        </PropertyGroup>
        <ZipDirectory SourceDirectory="$(TargetDir)" DestinationFile="$(PathOfScmod)" Overwrite="true" />
        <Message Text="The scmod file has been created:$(PathOfScmod)" Importance="high" />
    </Target>
</Project>
