<!--
  Phytomana 花药台配方（外部配方文件）。一个文件即可为花药台追加合成配方，
  规定「什么 + 什么」在花药台合成什么，无需改动源码。

  花药台用法（模仿植物魔法「花瓣药剂台」）：
    1. 拿水桶右键花药台注入水（空桶右键可取回水），无水时不吸收原料；每次合成耗尽一池水；
    2. 向花药台上投掷原料，材料会被吸收；
    3. 材料与某条配方的种类和数量完全一致时，再投掷任意种子即可合成，
       产出物品从台面上弹出。

  每个 <Recipe>：
    Result       产物方块类名（与代码类名一致）
    ResultCount  产物数量，默认 1（可省略）
    ManaCost     合成所需魔力，默认 0（可省略）。魔力需提前由魔力网络送入花药台
    CopyData     为 true 时产物继承第一份原料的 data（颜色变体保色），默认 false
    <Ingredient Name="原料方块类名" Count="数量" />   每种原料一行
                 ↑ 支持「类名:data」后缀精确到特殊值，如 SumeruPetalBlock:28 = 红色须弥花瓣
                   （16 色的 data = 色号 × 2，与语言键一致；不带后缀 = 不限颜色）

  匹配规则：无序匹配，提供的原料种类与数量须与配方完全一致。
-->
<FlowerRecipes>
  <Recipe Result="GrownDaisyFlower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:0" Count="4" />
  </Recipe>
  <Recipe Result="SunPowerFlower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:16" Count="1" />
    <Ingredient Name="SumeruPetalBlock:24" Count="2" />
    <Ingredient Name="SumeruPetalBlock:28" Count="1" />
  </Recipe>
  <Recipe Result="WaterDonFlower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:2" Count="2" />
    <Ingredient Name="SumeruPetalBlock:22" Count="2" />
  </Recipe>
  <Recipe Result="NightshadeFlower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:16" Count="1" />
    <Ingredient Name="SumeruPetalBlock:30" Count="1" />
    <Ingredient Name="SumeruPetalBlock:20" Count="2" />
  </Recipe>
  <Recipe Result="GourmaryllisFlower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:8" Count="1" />
    <Ingredient Name="SumeruPetalBlock:28" Count="2" />
    <Ingredient Name="SumeruPetalBlock:14" Count="1" />
  </Recipe>
  <Recipe Result="ThermalilyFlower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:12" Count="1" />
    <Ingredient Name="SumeruPetalBlock:8" Count="1" />
    <Ingredient Name="SumeruPetalBlock:28" Count="1" />
    <Ingredient Name="SumeruPetalBlock:0" Count="1" />
    <Ingredient Name="MagmaBucketBlock" Count="1" />
  </Recipe>
  <Recipe Result="ThornyRoseFlower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:28" Count="3" />
    <Ingredient Name="SumeruPetalBlock:18" Count="2" />
  </Recipe>
  <Recipe Result="ChestTransFlower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:16" Count="2" />
    <Ingredient Name="SumeruPetalBlock:14" Count="2" />
    <Ingredient Name="BasicRunesBlock:3" Count="1" />
  </Recipe>
  <Recipe Result="JadedFlower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:8" Count="1" />
    <Ingredient Name="SumeruPetalBlock:20" Count="1" />
    <Ingredient Name="SumeruPetalBlock:26" Count="1" />
    <Ingredient Name="MediumRunesBlock:4" Count="1" />
  </Recipe>
  <Recipe Result="ClaySandFlower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:14" Count="1" />
    <Ingredient Name="SumeruPetalBlock:16" Count="1" />
    <Ingredient Name="SumeruPetalBlock:18" Count="1" />
    <Ingredient Name="BasicRunesBlock:2" Count="1" />
  </Recipe>
  <Recipe Result="AciFlower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:4" Count="2" />
    <Ingredient Name="SumeruPetalBlock:26" Count="1" />
    <Ingredient Name="SumeruPetalBlock:20" Count="2" />
    <Ingredient Name="BasicRunesBlock:0" Count="1" />
    <Ingredient Name="MediumRunesBlock:6" Count="1" />
  </Recipe>
  <Recipe Result="TransChestV2Flower" ResultCount="1">
    <Ingredient Name="SumeruPetalBlock:0" Count="2" />
    <Ingredient Name="SumeruPetalBlock:14" Count="2" />
    <Ingredient Name="SumeruPetalBlock:18" Count="1" />
    <Ingredient Name="BasicRunesBlock:0" Count="1" />
    <Ingredient Name="ExpertRunesBlock:10" Count="1" />
    <Ingredient Name="ChestTransFlower" Count="1" />
  </Recipe>
</FlowerRecipes>