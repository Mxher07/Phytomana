<?xml version="1.0" encoding="utf-8"?>
<CanvasWidget xmlns="runtime-namespace:Game" Size="444, 408">
	<LabelWidget Text="花语的另一面" FontScale="1.0" Color="70, 40, 10" Size="200, 26" CanvasWidget.Position="10, 32" />
	<LabelWidget Text="夜影花的产能偏慢，却从不挑食——任何让天色暗下来的时刻，它都默默在工作。" WordWrap="true" FontScale="0.85" Color="80, 60, 36" Size="420, 80" CanvasWidget.Position="12, 66" />
	<LabelWidget Text="洞窟与地下不满足它的要求：它要看得到夜空。若罩在屋檐或树叶下，请以「露天」为第一考量。" WordWrap="true" FontScale="0.8" Color="110, 80, 40" Size="420, 70" CanvasWidget.Position="12, 156" />
	<LabelWidget Text="把夜晚让给它，把白昼还给出力更多的日耀花——它们是天作之合。" FontScale="0.8" Color="130, 100, 60" Size="420, 50" CanvasWidget.Position="12, 250" />
</CanvasWidget>